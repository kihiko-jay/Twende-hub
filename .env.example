NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Supabase (backend only – do NOT expose service role key to frontend)
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# Frontend (Vite) – only anon key is safe in the browser
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# M-Pesa STK Push
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=YOUR_MPESA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_MPESA_CONSUMER_SECRET
MPESA_SHORT_CODE=174379
MPESA_PASSKEY=YOUR_MPESA_PASSKEY
MPESA_CALLBACK_URL=http://localhost:3000/api/payments/mpesa-callback
# Required in production. Used to verify incoming M-Pesa webhooks.
# Required in production for secure webhook verification
MPESA_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# M-Pesa B2C payouts
MPESA_B2C_INITIATOR_NAME=YOUR_B2C_INITIATOR_NAME
MPESA_B2C_SECURITY_CREDENTIAL=YOUR_B2C_SECURITY_CREDENTIAL
MPESA_B2C_RESULT_URL=http://localhost:3000/api/payments/b2c-result
MPESA_B2C_QUEUE_TIMEOUT_URL=http://localhost:3000/api/payments/b2c-timeout

# Email / Resend
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=noreply@twendehub.com
EMAIL_FROM_NAME=TwendeHub

# Upstash Redis for shared API rate limiting
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN
